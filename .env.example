# Copy to .env and adjust. Never commit the real .env.

# Sign the session cookie. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me-with-a-long-random-value

# development | production  (production refuses to start without SECRET_KEY)
ENVIRONMENT=development

APP_NAME=Service Management System
# Development bind. Production also uses a wildcard socket; exact Windows
# Firewall rules control which LAN/public addresses and clients may connect.
APP_HOST=0.0.0.0
APP_PORT=8993
APP_RELOAD=true

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/service_management

# Password hashing work factor. Higher is slower and more resistant to guessing.
BCRYPT_ROUNDS=12

# Proof photos live here, outside the static directory.
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=8
MAX_PHOTOS_PER_RECORD=10

# Session lifetime in seconds (12 hours). Set SESSION_HTTPS_ONLY=true behind TLS.
SESSION_MAX_AGE_SECONDS=43200
SESSION_HTTPS_ONLY=false

# Administrator-only password recovery. Use a trusted HTTPS origin in production.
PUBLIC_BASE_URL=http://127.0.0.1:8993
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true

# Records per page in the maintenance records list.
PAGE_SIZE=10
MAX_PDF_RECORDS=250

# Storage is always UTC; this only affects what is displayed.
DISPLAY_TZ_OFFSET_MINUTES=180
DISPLAY_TZ_LABEL=UTC+03:00
